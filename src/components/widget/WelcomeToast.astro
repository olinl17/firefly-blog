---
// 欢迎提示组件 —— 首次访问时从右下角弹出，显示访客所在地
---

<script>
	const VISIT_SESSION_KEY = "blog_visit_flag";
	let hasShownToast = false;

	function createWelcomeToast(): HTMLElement {
		const toast = document.createElement("div");
		toast.id = "welcome-toast";
		toast.className =
			"fixed bottom-6 right-6 z-[9999] max-w-xs px-5 py-4 rounded-2xl shadow-lg " +
			"bg-(--card-bg) text-(--primary) border border-(--btn-regular-bg) " +
			"transform translate-y-full opacity-0 transition-all duration-500 ease-out";
		toast.innerHTML = `
			<div class="flex items-start gap-3">
				<span class="text-2xl">👋</span>
				<div>
					<p id="welcome-message" class="text-sm font-medium text-neutral-800 dark:text-neutral-200">你好，欢迎来到我的博客</p>
					<button
						type="button"
						class="mt-2 text-xs text-neutral-500 hover:text-(--primary) transition-colors"
						onclick="window.__closeWelcomeToast()"
					>
						关闭
					</button>
				</div>
			</div>
		`;
		document.body.appendChild(toast);
		return toast;
	}

	function closeWelcomeToast(): void {
		const toast = document.getElementById("welcome-toast");
		if (!toast) return;
		toast.classList.remove("translate-y-0", "opacity-100");
		toast.classList.add("translate-y-full", "opacity-0");
	}

	async function fetchLocation(): Promise<void> {
		try {
			const response = await fetch("https://v2.xxapi.cn/api/ip");
			const data = await response.json();
			if (data.code === 200 && data.data) {
				const message = document.getElementById("welcome-message");
				if (message) {
					message.textContent = `你好，来自${data.data.address}的朋友`;
				}
			}
		} catch {
			const message = document.getElementById("welcome-message");
			if (message) {
				message.textContent = "你好，欢迎来到我的博客";
			}
		}
	}

	async function showWelcomeToast(): Promise<void> {
		if (hasShownToast) return;
		const toast = createWelcomeToast();
		requestAnimationFrame(() => {
			toast.classList.remove("translate-y-full", "opacity-0");
			toast.classList.add("translate-y-0", "opacity-100");
		});
		hasShownToast = true;
		await fetchLocation();
		setTimeout(() => closeWelcomeToast(), 5000);
	}

	function initWelcome(): void {
		if (!sessionStorage.getItem(VISIT_SESSION_KEY)) {
			sessionStorage.setItem(VISIT_SESSION_KEY, "true");
			showWelcomeToast();
		}
	}

	window.__closeWelcomeToast = closeWelcomeToast;

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWelcome);
	} else {
		initWelcome();
	}
</script>
